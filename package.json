{
  "name": "my-collection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "我的书签 · 前端(web) + 后端(api) workspace",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @my-collection/web dev",
    "dev:api": "pnpm --filter @my-collection/api dev",
    "db:up": "docker compose --env-file .env -f dev/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f dev/docker-compose.yml down",
    "db:reset": "docker compose --env-file .env -f dev/docker-compose.yml down -v && pnpm db:up && pnpm migrate",
    "migrate": "pnpm --filter @my-collection/api migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
