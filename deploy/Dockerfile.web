# 前端镜像：builder（pnpm workspace 构建）→ nginx（静态站点 + /api/ 反代）

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# tsconfig.base.json 必须一起拷：apps/web/tsconfig.json 是 extends 它的，
# 缺了它 tsc 会退回默认配置（ES3、无 skipLibCheck）并在 node_modules 类型上炸一片
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter "@my-collection/web..."

COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/
RUN pnpm --filter @my-collection/web build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
