{
  "name": "@my-collection/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "我的书签 · 后端（Fastify + PostgreSQL）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
